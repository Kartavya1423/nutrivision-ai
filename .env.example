# ==============================================================================
# NutriVision AI: Environment Configuration
# ==============================================================================

# USDA FoodData Central API Key (Register free at https://fdc.nal.usda.gov/api-key-signup.html)
# Leave DEMO_KEY for development (rate limited to 30 requests/hour)
USDA_API_KEY=DEMO_KEY
USDA_API_URL=https://api.nal.usda.gov/fdc/v1

# Backend API Configuration
NUTRIVISION_API_HOST=0.0.0.0
NUTRIVISION_API_PORT=8000
NUTRIVISION_API_URL=http://127.0.0.1:8000

# Hardware Acceleration ("auto", "cuda", "cpu")
NUTRIVISION_DEVICE=auto

# Inference Defaults
NUTRIVISION_CONFIDENCE_THRESHOLD=0.35
NUTRIVISION_IOU_THRESHOLD=0.45
NUTRIVISION_ENABLE_GRADCAM=true
NUTRIVISION_ENABLE_NUTRITION=true

# Spatial Reference Object Calibration (Diameter in cm, e.g. Indian 10-Rupee coin = 2.7 cm)
NUTRIVISION_REFERENCE_OBJECT=coin
NUTRIVISION_REFERENCE_DIMENSION_CM=2.7
